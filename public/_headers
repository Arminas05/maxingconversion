# Headers for Cloudflare Workers static assets — https://developers.cloudflare.com/workers/static-assets/headers/
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/theme.css
  Cache-Control: public, max-age=3600

# config.js must never be cached hard — it is the file you edit to go live.
/assets/config.js
  Cache-Control: public, max-age=60, must-revalidate

# Static images, unlike theme.css/config.js, get new filenames if they ever
# change rather than being edited in place — safe to cache hard.
/assets/*.webp
  Cache-Control: public, max-age=604800, immutable
/assets/*.jpg
  Cache-Control: public, max-age=604800, immutable
/assets/*.png
  Cache-Control: public, max-age=604800, immutable
