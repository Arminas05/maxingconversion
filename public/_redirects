# Redirects for Cloudflare Workers static assets — https://developers.cloudflare.com/workers/static-assets/redirects/
# The site's entry point. Temporarily /toolkit/ (the $47 offer) while that's
# the primary push — swap back to /sales/ when /sales/ should be the front door again.
/                       /toolkit/               302
/index.html             /toolkit/               302

# /strategy-call/ was the original booking page. It and /sales/ ended up doing
# the same job, so it now redirects rather than splitting traffic between two
# near-identical pages. 301 so any existing links and search results follow.
/strategy-call          /sales/                 301
/strategy-call/         /sales/                 301
/strategy-call/*        /sales/                 301

# Friendly short links.
# /call and /book deliberately still go to /sales/ even though /toolkit/ is
# the front door: someone typing "/call" is telling you they want to book a
# call, and dropping them on a $47 product page instead would throw away the
# higher-value lead. Explicit intent beats the default destination.
/call                   /sales/                 301
/book                   /sales/                 301
/privacy                /privacy-policy/        301
/terms                  /terms-of-service/      301
/disclaimer             /earnings-disclaimer/   301
/cookies                /cookie-policy/         301

# Short link for the $47 toolkit page
/toolkit                /toolkit/               301
